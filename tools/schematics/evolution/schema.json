{
  "$schema": "http://json-schema.org/schema",
  "$id": "AngularEnterpriseStarterEvolution",
  "title": "Angular Enterprise Starter Evolution",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Evolution to install.",
      "enum": [
        "transloco",
        "runtime-config",
        "signal-store",
        "docker-ssr",
        "bootstrap",
        "tailwind"
      ],
      "x-prompt": {
        "message": "Which evolution do you want to add?",
        "type": "list",
        "items": [
          {
            "value": "transloco",
            "label": "Transloco i18n"
          },
          {
            "value": "runtime-config",
            "label": "Runtime config"
          },
          {
            "value": "signal-store",
            "label": "SignalStore"
          },
          {
            "value": "docker-ssr",
            "label": "Docker SSR"
          },
          {
            "value": "bootstrap",
            "label": "Bootstrap"
          },
          {
            "value": "tailwind",
            "label": "Tailwind"
          }
        ]
      }
    },
    "preview": {
      "type": "boolean",
      "description": "Show what the selected evolution would do without changing files.",
      "default": false
    },
    "storeScope": {
      "type": "string",
      "description": "SignalStore scope.",
      "enum": ["feature", "root"],
      "default": "feature"
    },
    "featureName": {
      "type": "string",
      "description": "Feature name used by feature-scoped SignalStore installers.",
      "default": "dashboard"
    },
    "featureComponent": {
      "type": "string",
      "description": "Whether the feature component already exists or should be generated.",
      "enum": ["existing", "create"],
      "default": "existing"
    },
    "storeName": {
      "type": "string",
      "description": "Root SignalStore name. Used only with --store-scope root.",
      "default": "app"
    },
    "bootstrapMode": {
      "type": "string",
      "description": "Bootstrap component generation mode.",
      "enum": ["all", "select"],
      "default": "all"
    },
    "bootstrapComponents": {
      "type": "string",
      "description": "Comma-separated Bootstrap components to generate when --bootstrap-mode select is used."
    }
  },
  "required": ["name"]
}
