{
  "$schema": "http://json-schema.org/schema",
  "$id": "AngularEnterpriseStarterEvolution",
  "title": "Angular Enterprise Starter Evolution",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Evolution to install.",
      "enum": [
        "transloco",
        "runtime-config",
        "layout-shell",
        "signal-store",
        "docker-ssr",
        "bootstrap",
        "tailwind",
        "ai-genkit"
      ],
      "x-prompt": {
        "message": "Which evolution do you want to add?",
        "type": "list",
        "items": [
          {
            "value": "transloco",
            "label": "Transloco i18n"
          },
          {
            "value": "runtime-config",
            "label": "Runtime config"
          },
          {
            "value": "layout-shell",
            "label": "Layout Shell"
          },
          {
            "value": "signal-store",
            "label": "SignalStore"
          },
          {
            "value": "docker-ssr",
            "label": "Docker SSR"
          },
          {
            "value": "bootstrap",
            "label": "Bootstrap"
          },
          {
            "value": "tailwind",
            "label": "Tailwind"
          },
          {
            "value": "ai-genkit",
            "label": "AI Genkit"
          }
        ]
      }
    },
    "preview": {
      "type": "boolean",
      "description": "Show what the selected evolution would do without changing files.",
      "default": false
    },
    "translocoLanguages": {
      "type": "string",
      "description": "Comma-separated languages to configure and generate.",
      "default": "en,it"
    },
    "translocoDefaultLanguage": {
      "type": "string",
      "description": "Default and fallback language; it must be selected in --transloco-languages.",
      "default": "en"
    },
    "layoutMode": {
      "type": "string",
      "description": "Layout component generation mode.",
      "enum": ["all", "select", "content-only"],
      "default": "all"
    },
    "layoutComponents": {
      "type": "string",
      "description": "Comma-separated layout components to generate when --layout-mode select is used."
    },
    "layoutHeaderBehavior": {
      "type": "string",
      "description": "Header positioning behavior when Header is selected.",
      "enum": ["flow", "sticky"],
      "default": "sticky"
    },
    "layoutSidebarMode": {
      "type": "string",
      "description": "Sidebar interaction mode when Sidebar is selected.",
      "enum": ["persistent", "collapsible"],
      "default": "persistent"
    },
    "layoutSidebarPosition": {
      "type": "string",
      "description": "Logical Sidebar position when Sidebar is selected.",
      "enum": ["start", "end"],
      "default": "start"
    },
    "layoutSidebarInitialState": {
      "type": "string",
      "description": "Initial Sidebar state when collapsible mode is used.",
      "enum": ["expanded", "collapsed"],
      "default": "expanded"
    },
    "layoutFooterBehavior": {
      "type": "string",
      "description": "Footer positioning behavior when Footer is selected.",
      "enum": ["flow", "sticky"],
      "default": "flow"
    },
    "layoutContentWidth": {
      "type": "string",
      "description": "Main content width behavior when Shell is selected.",
      "enum": ["fluid", "contained"],
      "default": "fluid"
    },
    "storeScope": {
      "type": "string",
      "description": "SignalStore scope.",
      "enum": ["feature", "root"],
      "default": "feature"
    },
    "featureName": {
      "type": "string",
      "description": "Feature name used by feature-scoped SignalStore installers.",
      "default": "dashboard"
    },
    "featureComponent": {
      "type": "string",
      "description": "Whether the feature component already exists or should be generated.",
      "enum": ["existing", "create"],
      "default": "existing"
    },
    "storeName": {
      "type": "string",
      "description": "Root SignalStore name. Used only with --store-scope root.",
      "default": "app"
    },
    "bootstrapMode": {
      "type": "string",
      "description": "Bootstrap component generation mode.",
      "enum": ["all", "select"],
      "default": "all"
    },
    "bootstrapComponents": {
      "type": "string",
      "description": "Comma-separated Bootstrap components to generate when --bootstrap-mode select is used."
    },
    "tailwindMode": {
      "type": "string",
      "description": "Tailwind component generation mode.",
      "enum": ["all", "select"],
      "default": "all"
    },
    "tailwindComponents": {
      "type": "string",
      "description": "Comma-separated Tailwind components to generate when --tailwind-mode select is used."
    },
    "aiProvider": {
      "type": "string",
      "description": "AI provider adapter to install.",
      "enum": ["google-ai"],
      "default": "google-ai"
    },
    "aiExample": {
      "type": "string",
      "description": "Optional AI application example to generate.",
      "enum": ["none", "summary"],
      "default": "none"
    },
    "aiModel": {
      "type": "string",
      "description": "Server-side model identifier written to .env.example.",
      "default": "gemini-3.5-flash"
    }
  },
  "required": ["name"]
}
