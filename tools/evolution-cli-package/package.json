{
  "name": "@filippolacagnina/angular-enterprise-starter",
  "version": "0.8.0-alpha.0",
  "description": "Versioned Evolution CLI and schematics for Angular Enterprise Starter.",
  "author": "Filippo Lacagnina",
  "license": "MIT",
  "bin": {
    "angular-enterprise-starter": "bin/angular-enterprise-starter.mjs",
    "aes": "bin/angular-enterprise-starter.mjs"
  },
  "schematics": "./schematics/collection.json",
  "exports": {
    "./design-system-catalog": {
      "types": "./catalog/design-system-catalog.d.ts",
      "import": "./catalog/design-system-catalog.mjs",
      "default": "./catalog/design-system-catalog.mjs"
    },
    "./design-system-catalog.json": "./catalog/design-system-catalog.json",
    "./design-system-sources": {
      "types": "./catalog/design-system-sources.d.ts",
      "import": "./catalog/design-system-sources.mjs",
      "default": "./catalog/design-system-sources.mjs"
    },
    "./design-system-sources.json": "./catalog/design-system-sources.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "catalog/",
    "schematics/",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilippoLacagnina/angular-enterprise-starter.git"
  },
  "bugs": {
    "url": "https://github.com/FilippoLacagnina/angular-enterprise-starter/issues"
  },
  "homepage": "https://github.com/FilippoLacagnina/angular-enterprise-starter#readme",
  "keywords": [
    "angular",
    "angular-21",
    "angular-cli",
    "angular-schematics",
    "angular-starter",
    "angular-template",
    "ai",
    "cli",
    "docker",
    "enterprise",
    "enterprise-architecture",
    "evolution-cli",
    "gemini",
    "genkit",
    "front-end",
    "i18n",
    "ngrx",
    "schematics",
    "signalstore",
    "signals",
    "starter",
    "starter-template",
    "ssr",
    "tailwind",
    "bootstrap",
    "component-catalog",
    "design-system",
    "transloco"
  ],
  "dependencies": {
    "@angular-devkit/core": "^21.2.19",
    "@angular-devkit/schematics": "^21.2.19",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@angular/cli": ">=21 <22"
  },
  "publishConfig": {
    "access": "public"
  }
}
