# Optional server-side AI foundation. Never expose provider credentials through Angular configuration.
AI_GENKIT_ENABLED=false
AI_GENKIT_DEFAULT_PROVIDER=google-ai
AI_GENKIT_TIMEOUT_MS=30000

AI_GENKIT_GOOGLE_AI_ENABLED=true
AI_GENKIT_GOOGLE_AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=replace-with-server-side-api-key

# Removable summary example. Keep false unless a real request guard is configured.
AI_GENKIT_ALLOW_UNAUTHENTICATED_EXAMPLE=false
