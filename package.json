{
  "name": "angular-enterprise-starter",
  "version": "0.5.1-alpha.0",
  "description": "Enterprise-ready Angular 21 starter with modular architecture, SSR, environments, API patterns, CI and documentation-first conventions.",
  "author": "Filippo Lacagnina",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FilippoLacagnina/angular-enterprise-starter.git"
  },
  "bugs": {
    "url": "https://github.com/FilippoLacagnina/angular-enterprise-starter/issues"
  },
  "homepage": "https://github.com/FilippoLacagnina/angular-enterprise-starter#readme",
  "keywords": [
    "angular",
    "angular-starter",
    "angular-template",
    "starter",
    "enterprise",
    "enterprise-architecture",
    "typescript",
    "standalone-components",
    "signals",
    "rxjs",
    "ssr",
    "prerender",
    "hydration",
    "eslint",
    "prettier",
    "github-actions",
    "starter-template",
    "clean-architecture"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "start:dev": "ng serve --configuration development",
    "start:test": "ng serve --configuration test",
    "build": "ng build",
    "build:local": "ng build --configuration local",
    "build:dev": "ng build --configuration development",
    "build:test": "ng build --configuration test",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,html,scss,css,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,html,scss,css,json,md,yml,yaml}\"",
    "deps:check": "node tools/dependency-update-report.mjs",
    "starter:cleanup": "node tools/starter-cleanup.mjs",
    "starter:cleanup:apply": "node tools/starter-cleanup.mjs --yes",
    "starter:cleanup:consumer": "node tools/starter-cleanup.mjs --yes --consumer-mode",
    "starter:evolution": "node tools/schematics/starter-evolution.mjs",
    "test": "ng test",
    "serve:ssr": "node dist/angular-enterprise-starter/server/server.mjs",
    "schematics:build": "tsc -p tools/schematics/tsconfig.json && node tools/schematics/copy-assets.mjs",
    "schematics:test": "vitest run tools/schematics",
    "evolution-cli:package": "npm run schematics:build && node tools/evolution-cli-package/build.mjs",
    "evolution-cli:pack": "npm run evolution-cli:package && npm pack ./dist/evolution-cli-package --pack-destination ./dist --cache ./dist/.npm-cache"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^21.2.11",
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "angular-eslint": "^21.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
